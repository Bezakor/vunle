# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ElevenLabs API Key
# Get yours at: https://elevenlabs.io (Profile -> API Keys)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Mailchimp (waitlist signups)
# API key: Mailchimp -> Profile icon -> Account & billing -> Extras -> API keys
MAILCHIMP_API_KEY=your-mailchimp-api-key-here
# Server prefix is the suffix after the last "-" in your API key (e.g. "us21")
MAILCHIMP_SERVER_PREFIX=us21
# Audience ID: Audience -> Settings -> Audience name and defaults -> Audience ID
MAILCHIMP_AUDIENCE_ID=your-audience-id-here
