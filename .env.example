# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ElevenLabs API Key
# Get yours at: https://elevenlabs.io (Profile -> API Keys)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Waitlist signups go straight to Formspree from the browser.
# The endpoint lives in src/components/landing/WaitlistBar.tsx; no key needed.

# The address the share card and canonical link are built from. Set this in the
# host's environment once the real domain is in place; without it both fall back
# to the Vercel address.
NEXT_PUBLIC_SITE_URL=https://vunle.vercel.app
